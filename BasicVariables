
from typing import Final

# String example
message: str = "DON'T PANIC!"
print(
f"The cover of the Hitchhiker's Guide to the Galaxy says: {message} "
    "in large, friendly letters."
)

# Change the message variable to a different string
message = "The best conversation I had was over forty million years ago…. "\
    "And that was with a coffee machine."
print(f"Marvin the Paranoid Android said: {message}")

# Float example
improbable_event_probability: float = 0.000912
print(
    "The Infinite Improbability Drive reading is: "
    f"{improbable_event_probability:.6f}"
)

# Boolean example
is_galaxy_friendly: bool = True
print(f"Is the galaxy friendly? {is_galaxy_friendly}")

# Careful: Types are not enforced at runtime, 
# so you can assign a value of a different type to the same variable.
is_galaxy_friendly = "Yes, it is!"
print(f"Is the galaxy friendly? {is_galaxy_friendly}")



# Uppercase variable names are typically used for constants in Python.
MEANING_OF_LIFE_THE_UNIVERSE_AND_EVERYTHING: Final[int] = 42
print("The meaning of life, the universe, and everything is: "
    f"{MEANING_OF_LIFE_THE_UNIVERSE_AND_EVERYTHING}")

# This will work but it is not recommended to change the value of a constant.
MEANING_OF_LIFE_THE_UNIVERSE_AND_EVERYTHING = 43
print("The meaning of life, the universe, and everything is now: "
    f"{MEANING_OF_LIFE_THE_UNIVERSE_AND_EVERYTHING}")

